:root {
  --ink: #171412;
  --ink-soft: #6b6560;
  --paper: #ffffff;
  --rule: #e4e0d9;
  --accent: #a3352c;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: "Literata", Georgia, serif;
  font-size: 1.05rem;
  line-height: 1.75;
  text-align: center;
}

a {
  color: var(--accent);
  text-decoration: none;
  transition: opacity 0.2s ease;
}

a:hover {
  opacity: 0.75;
}

/* ---------- Logo superior ---------- */

.Logo {
  display: block;
  width: 250px;
  height: auto;
  margin: 0.5rem auto 0;
}

/* ---------- Contenido ---------- */

.page {
  max-width: 700px;
  margin: 0 auto;
  padding: 0.5rem 1.5rem 5rem;
}

.masthead {
  margin-bottom: 2rem;
}

.masthead .tagline {
  font-family: "IBM Plex Mono", monospace;
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin: 0;
}

.profile-photo {
  display: block;
  width: 100%;
  max-width: 280px;
  height: auto;
  border-radius: 10px;
  background: var(--rule);
  margin: 0 auto 2rem;
}

.page-title {
  font-family: "Playfair Display", serif;
  font-size: 2rem;
  line-height: 1.2;
  margin: 0 0 1.2rem;
}

p {
  margin: 0 0 1.2rem;
}

ol {
  list-style-position: inside;
  padding: 0;
  margin: 0 0 1.8rem;
}

ol li {
  margin-bottom: 0.9rem;
}

/* ---------- Línea divisoria ---------- */

hr {
  width: min(520px, 90%);
  border: none;
  border-top: 2px solid #8b837c;
  margin: 2.8rem auto;
}

/* ---------- Logo separador ---------- */

.section-logo {
  display: block;
  width: 90px;
  height: auto;
  margin: 2.5rem auto;
}

/* ---------- Tarjeta de precios ---------- */

.pricing {
  max-width: 520px;
  margin: 0 auto 3rem;
  padding: 1.8rem;
  border: 1px solid var(--rule);
  border-radius: 12px;
  background: #faf9f7;
}

.pricing h2 {
  margin: 0 0 .7rem;
  font-family: "Playfair Display", serif;
}

.pricing p {
  margin-bottom: 1rem;
}

.pricing ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

.pricing li {
  padding: .8rem 0;
  border-bottom: 1px solid var(--rule);
}

.pricing li:last-child {
  border-bottom: none;
}

.pricing span {
  color: var(--ink-soft);
  font-size: .95rem;
}

/* ---------- Pie ---------- */

.site-footer {
  text-align: center;
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--rule);
  font-family: "IBM Plex Mono", monospace;
  font-size: .72rem;
  color: var(--ink-soft);
}

/* ---------- Responsive ---------- */

@media (max-width: 480px) {

  .Logo {
    width: 180px;
  }

  .section-logo {
    width: 70px;
  }

  .page {
    padding: 0.5rem 1.2rem 4rem;
  }

  .page-title {
    font-size: 1.6rem;
  }

  .pricing {
    padding: 1.3rem;
  }

}
